# ==============================================================
# COSMIC KI BADDIE - ENVIRONMENT CONFIGURATION
# Server: Side Quest Studio
# ==============================================================

# Discord Bot Token (Obtain from https://discord.com/developers/applications)
DISCORD_TOKEN="YOUR_BOT_TOKEN_HERE"

# Default Command Prefix (Can be changed in Discord per-server using /prefix set)
DEFAULT_PREFIX="!"

# Primary Guild / Server Name
MAIN_SERVER_NAME="Side Quest Studio"

# Optional: Specific Guild ID for instant slash command tree syncing during testing
# DEV_GUILD_ID=123456789012345678

# Database Path (SQLite)
DATABASE_PATH="data/cosmic_bot.db"

# Anti-Nuke Security Sensitive Action Thresholds (actions within 60s)
DEFAULT_ANTINUKE_THRESHOLD=3
ANTINUKE_TIME_WINDOW=60
